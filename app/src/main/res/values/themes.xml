<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AnsimDrive" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
    </style>

    <style name="SummaryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingEnd">48dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">44sp</item>
    </style>

    <style name="SummaryValue" parent="SummaryLabel">
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">52sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
